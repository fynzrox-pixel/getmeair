# Getmeair backend configuration.
# Copy to server/.env and fill in real values. Never commit .env.

GETMEAIR_HOST=127.0.0.1
GETMEAIR_PORT=8787
GETMEAIR_DB=./data/getmeair.sqlite

# Strong random secret used to sign/verify sessions. If omitted, a random
# secret is generated once in data/session-secret.txt.
GETMEAIR_SESSION_SECRET=

# Development login is ONLY for local testing. It must be 0 in production.
GETMEAIR_ALLOW_DEV_LOGIN=0

# Telegram bot token used to verify Telegram WebApp initData HMAC signatures.
TELEGRAM_BOT_TOKEN=

# The owner is identified by a verified Telegram user id after initial claim.
# The phone is an initial identifier only, never a permanent authorization factor.
OWNER_PHONE=+380991868393
OWNER_TELEGRAM_USER_ID=

# One-time bootstrap secret for the initial owner claim. Generate a long random
# value, use it once, then remove it from the environment.
OWNER_BOOTSTRAP_SECRET=

# One-time owner activation grant. The ledger idempotency key prevents repeats.
OWNER_INITIAL_FIRECOINS=100000

GETMEAIR_MAX_TRANSFER=100000
GETMEAIR_SESSION_TTL=2592000
