# Getmeair — Telegram API credentials
#
# Copy this file to `api.env` in the same directory and fill in your own values.
# Get them at https://my.telegram.org/apps (API Development Tools).
# NEVER commit `api.env` or any file containing a real API_HASH.
#
# API_ID is a decimal integer. API_HASH is a 32-character hexadecimal string.

API_ID=000000
API_HASH=00000000000000000000000000000000
